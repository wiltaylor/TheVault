label       = "Article"
plural      = "Articles"
description = "A longer piece of writing."
icon        = "file-text"

field topics {
  kind     = "list"
  items    = "taxonomy"
  label    = "Topics"
  taxonomy = "topic"
}

field published {
  kind  = "date"
  label = "Published"
}

field rating {
  kind  = "float"
  label = "Rating"
}

field tags {
  kind  = "list"
  label = "Tags"
  items = "string"
}

field related {
  kind     = "list"
  items    = "reference"
  label    = "Related"
  target   = "article"
  relation = "peer"
}

field body {
  kind  = "content"
  label = "Body"
}

template default {
  tab "Article" {
    slot "title"
    slot "topics"
    slot "published"
    slot "rating"
    slot "tags"
    slot "related"
    slot "body"
  }
}
