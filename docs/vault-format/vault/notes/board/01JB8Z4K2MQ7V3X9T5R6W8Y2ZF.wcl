title   = "Importer board"
created = "2026-10-12T09:20:00Z"
updated = "2026-10-12T11:03:44Z"

canvas board {
  height = 640

  viewport {
    x    = -120.0
    y    = -80.0
    zoom = 0.75
  }

  group plan {
    label  = "Plan"
    x      = -40.0
    y      = -40.0
    width  = 1000.0
    height = 480.0
    colour = "blue"
  }

  node goal {
    kind   = "card"
    x      = 0.0
    y      = 0.0
    width  = 260.0
    height = 160.0
    group  = "plan"
    colour = "yellow"

    heading {
      level = 2
      text  = "Goal"
    }

    paragraph {
      text = "**Import Capacities** without losing [[01JB8Z4K2MQ7V3X9T5R6W8Y2ZA]]"
    }

    list {
      style = "todo"

      item {
        text    = "Read the export"
        checked = true
      }

      item {
        text = "Map the types"
      }
    }
  }

  node importer {
    kind     = "note"
    x        = 340.0
    y        = 0.0
    width    = 300.0
    height   = 180.0
    group    = "plan"
    note     = "01JB8Z4K2MQ7V3X9T5R6W8Y2ZA"
    template = "card"
  }

  node open_work {
    kind   = "card"
    x      = 700.0
    y      = 0.0
    width  = 240.0
    height = 400.0
    group  = "plan"

    query_view {
      query = "from specimen where under(status, \"Active\") sort due asc limit 10"

      view cards {
        kind     = "cards"
        template = "card"
      }
    }
  }

  node diagram {
    kind   = "card"
    x      = 0.0
    y      = 200.0
    width  = 300.0
    height = 220.0
    group  = "plan"

    image {
      asset   = "01JB9A0C3D4E5F6G7H8J9K0M1N"
      caption = "The importer's stages"
    }
  }

  node docs {
    kind   = "card"
    x      = 0.0
    y      = 520.0
    width  = 260.0
    height = 120.0

    paragraph {
      text = "[Importer docs](https://example.com/importer-docs)"
    }

    code {
      language = "sh"
      source   = "vault import capacities export.zip"
    }
  }

  node scribble {
    kind   = "card"
    x      = 340.0
    y      = 520.0
    width  = 200.0
    height = 120.0

    ink {
      width  = 200
      height = 120

      stroke {
        tool   = "pen"
        colour = "#dc2626"
        size   = 3.0
        points = [10.0, 60.0, 0.5, 100.0, 20.0, 0.7, 190.0, 60.0, 0.5]
      }
    }
  }

  edge goal_to_importer {
    from      = "goal"
    to        = "importer"
    from_side = "right"
    to_side   = "left"
    label     = "delivers"
    colour    = "green"
    arrow     = "end"
  }

  edge importer_to_work {
    from   = "importer"
    to     = "open_work"
    colour = "gray"
    arrow  = "none"
  }

  edge docs_to_goal {
    from  = "docs"
    to    = "goal"
    arrow = "start"
  }

  edge scribble_to_importer {
    from  = "scribble"
    to    = "importer"
    arrow = "both"
  }
}
