label       = "Specimen"
plural      = "Specimens"
description = "A type with one field of every kind, used as the reference example."
icon        = "flask-conical"
colour      = "purple"

field subtitle {
  kind  = "string"
  label = "Subtitle"
}

field estimate {
  kind     = "int"
  label    = "Estimate (hours)"
  required = true
  default  = 1
}

field word_count {
  kind     = "int"
  label    = "Word count"
  computed = true
}

field score {
  kind  = "float"
  label = "Score"
}

field done {
  kind    = "bool"
  label   = "Done"
  default = false
}

field due {
  kind  = "date"
  label = "Due"
}

field starts_at {
  kind  = "datetime"
  label = "Starts at"
}

field span {
  kind  = "date_range"
  label = "Span"
  of    = "date"
}

field session {
  kind  = "date_range"
  label = "Session"
  of    = "date_or_datetime"
}

field homepage {
  kind  = "url"
  label = "Homepage"
}

field priority {
  kind          = "select"
  label         = "Priority"
  options       = ["low", "medium", "high"]
  option_labels = ["Low", "Medium", "High"]
  default       = "medium"
}

field channels {
  kind     = "select"
  label    = "Channels"
  multiple = true
  options  = ["email", "chat", "phone"]
}

field status {
  kind     = "taxonomy"
  label    = "Status"
  taxonomy = "status"
  required = true
  default  = "Inbox"
}

field topics {
  kind     = "taxonomy"
  label    = "Topics"
  taxonomy = "topic"
  multiple = true
}

field board {
  kind      = "reference"
  label     = "Board"
  target    = "board"
  relation  = "one_way"
  on_delete = "restrict"
}

field parent {
  kind      = "reference"
  label     = "Parent"
  target    = "specimen"
  relation  = "two_way"
  inverse   = "children"
  on_delete = "cascade"
}

field children {
  kind      = "reference"
  label     = "Children"
  target    = "specimen"
  relation  = "two_way"
  inverse   = "parent"
  multiple  = true
  on_delete = "unlink"
}

field related {
  kind     = "reference"
  label    = "Related"
  target   = "specimen"
  relation = "peer"
  multiple = true
}

field aliases {
  kind   = "list"
  label  = "Aliases"
  items  = "string"
  labels = "alias_labels"
}

field alias_labels {
  kind  = "list"
  label = "Alias labels"
  items = "string"
}

field import_ref {
  kind   = "string"
  label  = "Import reference"
  hidden = true
}

field extra {
  kind   = "dict"
  label  = "Extra"
  values = "string"
}

field place {
  kind  = "location"
  label = "Place"
  map   = "geo"
}

field desk {
  kind  = "location"
  label = "Desk"
  map   = "image"
  image = "01JB9A0C3D4E5F6G7H8J9K0M1Q"
}

field body {
  kind  = "content"
  label = "Body"
}

field cover {
  kind   = "asset"
  label  = "Cover"
  accept = "image"
}

field attachments {
  kind     = "asset"
  label    = "Attachments"
  multiple = true
}

field sketch {
  kind  = "ink"
  label = "Sketch"
}

field plan {
  kind  = "canvas"
  label = "Plan"
}

template default {
  label = "Full page"

  tab "Overview" {
    slot "title"
    paragraph {
      text = "**{{title}}** is due {{due}}, in {{status}}."
    }
    slot "subtitle"
    columns {
      column {
        width = 1
        slot "status"
        slot "priority"
      }
      column {
        width = 1
        slot "due"
        slot "estimate" {
          label = "Hours"
        }
      }
    }
    slot "body"
  }

  tab "Relations" {
    when = "!done"
    slot "parent"
    slot "children"
    slot "related"
    heading {
      level = 2
      text  = "Open children"
    }
    query_view {
      query        = "from specimen where parent == this && !done sort due asc"
      default_view = "open"

      view open {
        kind    = "table"
        columns = ["title", "status", "due"]
      }
    }
  }

  tab "Media" {
    slot "cover"
    slot "attachments"
    slot "sketch"
    slot "plan"
    slot "place"
    slot "desk"
  }

  tab "Form" {
    columns {
      column {
        width = 1
        control {
          field       = "subtitle"
          kind        = "text"
          label       = "Subtitle"
          placeholder = "One line under the title"
        }
        control {
          field = "estimate"
          kind  = "number"
          min   = 0
          step  = 1
        }
        control {
          field = "score"
          kind  = "slider"
          min   = 0
          max   = 10
          step  = 0.5
        }
        control {
          field = "done"
          kind  = "toggle"
        }
        control {
          field = "priority"
          kind  = "radio"
        }
        control {
          field = "status"
          kind  = "dropdown"
        }
        control {
          field = "topics"
          kind  = "chips"
        }
      }
      column {
        width = 1
        control {
          field = "due"
          kind  = "calendar"
        }
        control {
          field = "span"
          kind  = "calendar"
        }
        control {
          field = "starts_at"
          kind  = "time"
          label = "Start time"
        }
        control {
          field = "estimate"
          kind  = "rating"
          label = "Effort"
          max   = 5
        }
      }
    }
    control {
      field = "word_count"
      kind  = "number"
      label = "Words, counted on save"
    }
  }
}

template card {
  tab "Card" {
    image {
      field = "cover"
      alt   = "Cover of {{title}}"
    }
    slot "title"
    slot "status"
    slot "due"
  }
}

handler "before_update" {
  script   = "specimen"
  function = "count_words"
}

handler "after_create" {
  script        = "specimen"
  function      = "announce"
  allow_domains = ["hooks.example.com"]
  secrets       = ["announce_token"]
}
