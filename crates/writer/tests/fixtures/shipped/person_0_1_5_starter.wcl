label       = "Person"
plural      = "People"
description = "Someone you work with."
icon        = "user"
colour      = "purple"

field email {
  kind  = "string"
  label = "Email"
}

field phones {
  kind        = "list"
  label       = "Phones"
  description = "Phone numbers in international (E.164) form, such as +61400000000."
  items       = "string"
}

field addresses {
  kind  = "list"
  label = "Addresses"
  items = "string"
}

field device_contacts {
  kind        = "dict"
  label       = "Device contacts"
  description = "The phone contact linked to this person, by device id."
  values      = "string"
  hidden      = true
}

field organisation {
  kind  = "string"
  label = "Organisation"
}

field homepage {
  kind  = "url"
  label = "Homepage"
}

field body {
  kind  = "content"
  label = "Notes"
}

template default {
  tab "Person" {
    slot "title" {
      label = "Name"
    }
    slot "email"
    slot "phones"
    slot "addresses"
    slot "organisation"
    slot "homepage"
    slot "body"
  }

  tab "Work" {
    query_view {
      title = "Projects"
      query = "from project where owner == this sort title asc"

      view list {
        kind = "list"
      }
    }

    query_view {
      title = "Tasks"
      query = "from task where assignee == this sort due asc"

      view table {
        kind    = "table"
        columns = ["title", "status", "due"]
      }
    }
  }
}

template card {
  tab "Card" {
    slot "title"
    slot "organisation"
  }
}
