label         = "Gmail sync"
description   = "Pulls Gmail into email notes. Connect Google in Settings > Integrations to start it."
schedule      = "*/10 * * * *"
script        = "google_gmail"
timeout       = "PT5M"
allow_domains = ["oauth2.googleapis.com", "gmail.googleapis.com", "www.googleapis.com"]
secrets       = ["google_client_id", "google_client_secret", "google_refresh_token"]
paused        = true
