label       = "Quarterly note"
plural      = "Quarterly notes"
description = "One note for each quarter of the year."
icon        = "calendars"
colour      = "brown"

field date {
  kind     = "date"
  label    = "Starts on"
  required = true
}

field body {
  kind  = "content"
  label = "Body"
}

template default {
  tab "Quarter" {
    period_calendar {
      period = "quarter"
    }
    slot "body"
  }
}

template card {
  tab "Card" {
    slot "title"
    slot "date"
  }
}
