label       = "Person"
plural      = "People"
description = "Someone you work with."
icon        = "user"
colour      = "purple"

field emails {
  kind  = "list"
  label = "Emails"

  item {
    kind = "dict"

    key address {
      kind     = "string"
      label    = "Address"
      required = true
    }

    key label {
      kind        = "string"
      label       = "Label"
      description = "mobile, home, work, main, other, or the phone's own label."
    }
  }
}

field phones {
  kind        = "list"
  label       = "Phones"
  description = "Phone numbers in international (E.164) form, such as +61400000000."

  item {
    kind = "dict"

    key number {
      kind     = "string"
      label    = "Number"
      required = true
    }

    key label {
      kind        = "string"
      label       = "Label"
      description = "mobile, home, work, main, other, or the phone's own label."
    }
  }
}

field addresses {
  kind        = "list"
  label       = "Addresses"
  description = "Postal addresses, each on one line with its lines joined by commas."

  item {
    kind = "dict"

    key address {
      kind     = "string"
      label    = "Address"
      required = true
    }

    key label {
      kind        = "string"
      label       = "Label"
      description = "home, work, other, or the phone's own label."
    }
  }
}

field organisation {
  kind  = "string"
  label = "Organisation"
}

field job_title {
  kind  = "string"
  label = "Job title"
}

field nickname {
  kind  = "string"
  label = "Nickname"
}

field birthday {
  kind        = "string"
  label       = "Birthday"
  description = "YYYY-MM-DD, or --MM-DD when the year is not known."
}

field websites {
  kind  = "list"
  label = "Websites"
  items = "url"
}

field contact_note {
  kind        = "string"
  label       = "Contact note"
  description = "The note on the phone contact."
}

field phone_contact {
  kind        = "bool"
  label       = "On the phone"
  description = "Keep this person as a contact on the phones that sync contacts. Untick it to take the contact off them; tick it to put it back."
  default     = true
}

field photo {
  kind   = "asset"
  label  = "Photo"
  accept = "image"
}

field device_contacts {
  kind        = "dict"
  label       = "Device contacts"
  description = "The phone contact linked to this person, by device id."
  values      = "string"
  hidden      = true
}

field homepage {
  kind  = "url"
  label = "Homepage"
}

field body {
  kind  = "content"
  label = "Notes"
}

template default {
  tab "Person" {
    slot "photo"
    slot "title" {
      label = "Name"
    }
    slot "emails"
    slot "phones"
    slot "addresses"
    slot "organisation"
    slot "job_title"
    slot "nickname"
    slot "birthday"
    slot "websites"
    slot "contact_note"
    slot "phone_contact"
    slot "homepage"
    slot "body"
  }

  tab "Work" {
    query_view {
      title = "Projects"
      query = "from project where owner == this sort title asc"

      view list {
        kind = "list"
      }
    }

    query_view {
      title = "Tasks"
      query = "from task where assignee == this sort due asc"

      view table {
        kind    = "table"
        columns = ["title", "status", "due"]
      }
    }
  }
}

template card {
  tab "Card" {
    slot "photo"
    slot "title"
    slot "organisation"
  }
}
