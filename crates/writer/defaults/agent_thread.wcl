label       = "Agent thread"
plural      = "Agent threads"
description = "One chat with an agent: what was said, the tools it used and the changes it proposed."
icon        = "message-square"
colour      = "purple"

field agent {
  kind        = "string"
  label       = "Agent"
  description = "The name of the agent the thread belongs to."
}

field origin {
  kind        = "string"
  label       = "Origin"
  description = "user for a thread the user started, trigger:<name> for one a trigger started, mention for a call from a note, dispatch for notes sent to the agent."
}

field last_activity {
  kind  = "datetime"
  label = "Last activity"
}

field pending {
  kind        = "int"
  label       = "Pending proposals"
  description = "How many proposed changes wait for the user."
  hidden      = true
}

field notes {
  kind        = "list"
  items       = "reference"
  target      = "*"
  label       = "Notes"
  description = "The notes the thread is about: the notes sent to the agent, or the note that called it."
  hidden      = true
}

field question {
  kind        = "string"
  label       = "Question"
  description = "What the agent asked the user and waits for an answer to."
  hidden      = true
}

field transcript {
  kind        = "string"
  label       = "Transcript"
  description = "The conversation as the server resumes it, as JSON."
  hidden      = true
}

field body {
  kind  = "content"
  label = "Conversation"
}

template default {
  tab "Thread" {
    slot "agent"
    slot "last_activity"
    slot "body"
  }
}

template card {
  tab "Card" {
    slot "title"
    slot "agent"
    slot "last_activity"
  }
}

list_page {
  view = "details"
  sort = "last_activity desc"
}
