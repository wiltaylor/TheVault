# TheVault's settings for compose.yaml. Copy this file to .env beside compose.yaml and fill it in.

# The login password for the new vault. Only used on the first start, when /data holds no vault;
# later starts ignore it. Change the password later with: docker compose exec thevault vault passwd
VAULT_PASSWORD=

# The profile every docker compose command uses: empty for LAN or Tailscale, https, or cloudflare.
COMPOSE_PROFILES=

# The image tag to run: latest, or a release version such as 0.1.12 to stay on it.
THEVAULT_VERSION=latest

# The host port the web app listens on. Set 127.0.0.1:8080 to keep it to this machine when Caddy or a tunnel fronts it.
THEVAULT_PORT=8080

# Where the vault lives: the named volume "data", or a host folder such as ./data owned by uid 1000.
THEVAULT_DATA=data

# Where the vault's secret key lives: the named volume "config", or a host folder such as ./config owned by uid 1000.
THEVAULT_CONFIG=config

# The container's time zone, as an IANA name. Scheduled tasks take their own zone from each task.
TZ=UTC

# The https profile: the domain Caddy serves and gets a certificate for, such as vault.example.com.
THEVAULT_DOMAIN=

# The cloudflare profile: the token of the tunnel, from the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# The cloudflare profile: the cloudflared image version. Cloudflare publishes no major-version tag.
CLOUDFLARED_VERSION=2026.10.1
