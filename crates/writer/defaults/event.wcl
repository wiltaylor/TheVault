label       = "Event"
plural      = "Events"
description = "One event, or one occurrence of a recurring event, on a Google calendar."
icon        = "calendar"
colour      = "blue"

field when {
  kind  = "date_range"
  label = "When"
  of    = "date_or_datetime"
}

field calendar {
  kind        = "string"
  label       = "Calendar"
  description = "The id of the Google calendar the event is on, one of the Google sync note's calendars."
}

field calendar_name {
  kind        = "string"
  label       = "Calendar name"
  description = "The name of the calendar, from your Google calendar list. The calendar sync fills it."
  computed    = true
}

field location {
  kind  = "string"
  label = "Location"
}

field description {
  kind  = "content"
  label = "Description"
}

field attendees {
  kind   = "list"
  items  = "reference"
  label  = "Attendees"
  target = "person"
}

field attendees_raw {
  kind        = "list"
  label       = "Attendees (as sent)"
  description = "Each attendee's address as Google gave it."
  items       = "string"
}

field organiser {
  kind  = "string"
  label = "Organiser"
}

field status {
  kind    = "select"
  label   = "Status"
  options = ["confirmed", "tentative", "cancelled"]
}

field meet_url {
  kind  = "url"
  label = "Meet link"
}

field series {
  kind        = "string"
  label       = "Repeats"
  description = "The recurrence rule of the series this occurrence belongs to."
  computed    = true
}

field google_ref {
  kind        = "string"
  label       = "Google reference"
  description = "Google's id for the event, or for this occurrence of a series."
  hidden      = true
}

field etag {
  kind        = "string"
  label       = "ETag"
  description = "Google's version of the event, as last synced."
  hidden      = true
}

field snapshot {
  kind        = "dict"
  label       = "Snapshot"
  description = "The synced fields as Google last sent them, so a sync can tell which side changed."
  values      = "string"
  hidden      = true
}

field send_updates {
  kind        = "string"
  label       = "Send updates"
  description = "Set to all by the Outbox for one write-back, so Google emails the attendees. The write-back clears it."
  hidden      = true
}

handler "after_create" {
  script        = "google_event"
  allow_domains = ["oauth2.googleapis.com", "www.googleapis.com"]
  secrets       = ["google_client_id", "google_client_secret", "google_refresh_token", "google_settings"]
}

handler "after_update" {
  script        = "google_event"
  allow_domains = ["oauth2.googleapis.com", "www.googleapis.com"]
  secrets       = ["google_client_id", "google_client_secret", "google_refresh_token", "google_settings"]
}

handler "after_delete" {
  script        = "google_event"
  allow_domains = ["oauth2.googleapis.com", "www.googleapis.com"]
  secrets       = ["google_client_id", "google_client_secret", "google_refresh_token", "google_settings"]
}

template default {
  tab "Event" {
    columns {
      column {
        slot "when"
        slot "series"
        slot "location"
      }
      column {
        slot "calendar"
        slot "calendar_name"
        slot "status"
        slot "meet_url"
      }
    }
    slot "attendees"
    slot "organiser"
    slot "description"
  }
}

template card {
  tab "Card" {
    slot "title"
    slot "when"
    slot "location"
  }
}
