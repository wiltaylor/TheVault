label       = "Yearly note"
plural      = "Yearly notes"
description = "One note for each year."
icon        = "calendar-check"
colour      = "red"

field date {
  kind     = "date"
  label    = "Starts on"
  required = true
}

field body {
  kind  = "content"
  label = "Body"
}

template default {
  tab "Year" {
    period_calendar {
      period = "year"
    }
    slot "body"
  }
}

template card {
  tab "Card" {
    slot "title"
    slot "date"
  }
}
