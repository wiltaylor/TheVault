label       = "Message"
plural      = "Messages"
description = "One SMS, MMS or RCS message, sent or received on a phone."
icon        = "message-square"
colour      = "blue"

field channel {
  kind    = "select"
  label   = "Channel"
  options = ["sms", "mms", "rcs"]
}

field direction {
  kind    = "select"
  label   = "Direction"
  options = ["in", "out"]
}

field from {
  kind   = "reference"
  label  = "From"
  target = "person"
}

field to {
  kind   = "list"
  items  = "reference"
  label  = "To"
  target = "person"
}

field from_raw {
  kind        = "string"
  label       = "From (number or name)"
  description = "The sender's number or display name, as the phone gave it."
}

field to_raw {
  kind        = "list"
  label       = "To (numbers or names)"
  description = "Each recipient's number or display name, as the phone gave it."
  items       = "string"
}

field conversation {
  kind   = "reference"
  label  = "Conversation"
  target = "conversation"
}

field sent {
  kind  = "datetime"
  label = "Sent"
}

field body {
  kind  = "content"
  label = "Text"
}

field attachments {
  kind  = "list"
  items = "asset"
  label = "Attachments"
}

field partial {
  kind        = "bool"
  label       = "Partial"
  description = "Captured from a notification, so the text or attachments may be incomplete."
  default     = false
}

field scam_probability {
  kind        = "float"
  label       = "Scam probability"
  description = "Model estimate from 0 to 1. Missing means unclassified. A low estimate is not proof of safety."
}

field communication_category {
  kind    = "select"
  label   = "Communication category"
  options = ["scam", "spam", "marketing", "personal", "transactional", "other"]
}

field processed {
  kind    = "bool"
  label   = "Processed"
  default = false
}

field device_ref {
  kind        = "string"
  label       = "Device reference"
  description = "The phone's id for the message, so it is captured once."
}

field agent_safety_reason {
  kind    = "select"
  options = ["allow", "prompt_injection", "sensitive_credentials", "scam", "spam", "marketing"]
  label   = "Agent safety classification"
}

template default {
  tab "Message" {
    columns {
      column {
        slot "from"
        slot "processed"
        slot "scam_probability"
        slot "communication_category"
        slot "to"
      }
      column {
        slot "sent"
        slot "conversation"
      }
    }
    slot "body"
    image {
      field = "attachments"
      alt   = "Picture sent with the message"
    }
    slot "attachments"
  }
}

template card {
  tab "Card" {
    image {
      field = "attachments"
      alt   = "Picture sent with the message"
    }
    slot "title"
    slot "sent"
    slot "processed"
  }
}

list_page {
  view      = "details"
  sort      = "sent desc"
  page_size = 50
}
