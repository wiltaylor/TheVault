{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheVault",
  "mainBinaryName": "thevault",
  "version": "0.1.8",
  "identifier": "dev.wiltaylor.thevault",
  "build": {
    "frontendDist": "../../../web/dist"
  },
  "app": {
    "windows": [],
    "enableGTKAppId": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/thevault.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/thevault.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NzgyMjI4MzVBRTYxMjIKUldRaVlhNDFLQ0o0dVYwNW9wQnRsanhkNzFDaFJINXRTaWRlaXNvbUJFYThoS2x4UEIxd2duY2sK",
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true
    }
  }
}
