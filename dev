#!/usr/bin/env bash
# Run a command inside the thevault-dev container, in the current directory.
# Usage: ./dev cargo test    ./dev pnpm -C web test    ./dev just check
#
# The image tag is a hash of docker/dev.Dockerfile, so editing the Dockerfile
# builds a new image on the next call, and checkouts with different Dockerfiles
# each keep their own image.
set -euo pipefail

repo_root=$(cd "$(dirname "$0")" && pwd)
dockerfile="$repo_root/docker/dev.Dockerfile"
hash=$(sha256sum "$dockerfile" | cut -c1-12)
image="thevault-dev:$hash"
workdir=$(pwd)

if ! docker image inspect "$image" >/dev/null 2>&1; then
  docker build -t "$image" --label "thevault.dockerfile-hash=$hash" \
    -f "$dockerfile" "$repo_root/docker" >&2
fi

tty_flags=()
if [ -t 0 ] && [ -t 1 ]; then
  tty_flags=(-it)
fi

# The Android release keystore lives outside the repository (D10): pass its passwords through by
# name, so they never appear on the docker command line, and mount the keystore file read-only.
keystore_flags=()
for var in THEVAULT_ANDROID_KEYSTORE_PASSWORD THEVAULT_ANDROID_KEY_ALIAS THEVAULT_ANDROID_KEY_PASSWORD; do
  if [ -n "${!var:-}" ]; then
    keystore_flags+=(-e "$var")
  fi
done
if [ -n "${THEVAULT_ANDROID_KEYSTORE:-}" ]; then
  keystore=$(realpath "$THEVAULT_ANDROID_KEYSTORE")
  keystore_flags+=(-e "THEVAULT_ANDROID_KEYSTORE=$keystore" -v "$keystore:$keystore:ro")
fi

# The Android emulator (`just android-emulator-checks`) needs KVM; pass it through when the host
# has it. Its AVD lives in the thevault-avd volume, and the emulator checks' settings pass through.
kvm_flags=()
if [ -e /dev/kvm ]; then
  kvm_flags=(--device /dev/kvm)
fi
for var in THEVAULT_APK THEVAULT_EMULATOR_OUT THEVAULT_CHECKS THEVAULT_PERIODIC_WAIT; do
  if [ -n "${!var:-}" ]; then
    kvm_flags+=(-e "$var")
  fi
done

exec docker run --rm "${tty_flags[@]}" "${keystore_flags[@]}" "${kvm_flags[@]}" \
  --network host \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp/home \
  -e ANDROID_USER_HOME=/tmp/home/.android \
  -e CARGO_TERM_COLOR=always \
  -v thevault-cargo:/cargo \
  -v thevault-pnpm:/pnpm-store \
  -v thevault-gradle:/gradle \
  -v thevault-avd:/avd \
  -v "$workdir:$workdir" \
  -w "$workdir" \
  "$image" "$@"
